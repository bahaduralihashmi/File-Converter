/* ========================================
   LIGHT THEME STYLESHEET
   All Files Converter AI v3.0
   ======================================== */

/* ===== MAIN WINDOW ===== */
QMainWindow {
    background-color: #F5F6FA;
}

QWidget {
    background-color: transparent;
    color: #2D3436;
    font-family: "Segoe UI", "Arial", sans-serif;
    font-size: 13px;
}

/* ===== SIDEBAR ===== */
Sidebar {
    background-color: #FFFFFF;
    border-right: 1px solid #E8E8E8;
}

Sidebar QPushButton {
    color: #636E72;
    padding: 12px 16px;
    border: none;
    border-radius: 8px;
    text-align: left;
    font-weight: 500;
}

Sidebar QPushButton:hover {
    background-color: #F5F6FA;
    color: #6C63FF;
}

Sidebar QPushButton:checked {
    background-color: rgba(108, 99, 255, 0.1);
    color: #6C63FF;
}

/* ===== TOP BAR ===== */
TopBar {
    background-color: #FFFFFF;
    border-bottom: 1px solid #E8E8E8;
}

TopBar QLabel {
    color: #2D3436;
}

/* ===== CARDS ===== */
QFrame#statsCard {
    background-color: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 12px;
}

QFrame#statsCard QLabel {
    color: #2D3436;
}

/* ===== BUTTONS ===== */
QPushButton {
    padding: 8px 16px;
    border: none;
    border-radius: 6px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: #F5F6FA;
}

QPushButton:pressed {
    background-color: #E8E8F0;
}

/* Primary Button */
QPushButton[primary="true"] {
    background-color: #6C63FF;
    color: #FFFFFF;
}

QPushButton[primary="true"]:hover {
    background-color: #5A52D5;
}

/* Success Button */
QPushButton[success="true"] {
    background-color: #00C9A7;
    color: #FFFFFF;
}

QPushButton[success="true"]:hover {
    background-color: #00B897;
}

/* Danger Button */
QPushButton[danger="true"] {
    background-color: #FF6B6B;
    color: #FFFFFF;
}

QPushButton[danger="true"]:hover {
    background-color: #E55555;
}

/* ===== INPUT FIELDS ===== */
QLineEdit {
    background-color: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 6px;
    padding: 8px 12px;
}

QLineEdit:focus {
    border-color: #6C63FF;
}

QLineEdit:hover {
    border-color: #6C63FF;
}

QComboBox {
    background-color: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 6px;
    padding: 8px 12px;
}

QComboBox:hover {
    border-color: #6C63FF;
}

QComboBox:focus {
    border-color: #6C63FF;
}

QComboBox::drop-down {
    border: none;
    padding-right: 10px;
}

/* ===== TABLES ===== */
QTableWidget {
    background-color: #FFFFFF;
    border: 1px solid #E8E8E8;
    border-radius: 8px;
    gridline-color: #F0F0F0;
}

QTableWidget::item {
    padding: 8px 12px;
}

QTableWidget::item:selected {
    background-color: rgba(108, 99, 255, 0.1);
    color: #2D3436;
}

QHeaderView::section {
    background-color: #F8F9FA;
    padding: 8px 12px;
    border: none;
    border-bottom: 1px solid #E8E8E8;
    font-weight: 600;
}

/* ===== PROGRESS BAR ===== */
QProgressBar {
    border: none;
    border-radius: 4px;
    background-color: #E8E8E8;
    height: 8px;
}

QProgressBar::chunk {
    background-color: #6C63FF;
    border-radius: 4px;
}

/* ===== SCROLLBARS ===== */
QScrollBar:vertical {
    background-color: #F5F6FA;
    border-radius: 4px;
    width: 8px;
}

QScrollBar::handle:vertical {
    background-color: #C8C8D0;
    border-radius: 4px;
}

QScrollBar::handle:vertical:hover {
    background-color: #A8A8B0;
}

QScrollBar:horizontal {
    background-color: #F5F6FA;
    border-radius: 4px;
    height: 8px;
}

QScrollBar::handle:horizontal {
    background-color: #C8C8D0;
    border-radius: 4px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #A8A8B0;
}

/* ===== TABS ===== */
QTabWidget::pane {
    border: 1px solid #E8E8E8;
    border-radius: 8px;
    background-color: #FFFFFF;
}

QTabBar::tab {
    padding: 8px 16px;
    border: none;
    border-radius: 6px 6px 0 0;
}

QTabBar::tab:selected {
    background-color: #6C63FF;
    color: #FFFFFF;
}

QTabBar::tab:hover:!selected {
    background-color: #F5F6FA;
}

/* ===== GROUP BOXES ===== */
QGroupBox {
    border: 1px solid #E8E8E8;
    border-radius: 8px;
    margin-top: 12px;
    padding-top: 12px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 8px;
    font-weight: 600;
}

/* ===== STATUS BAR ===== */
QStatusBar {
    background-color: #2D3436;
    color: #A0A0A0;
}

QStatusBar QLabel {
    color: #A0A0A0;
}

/* ===== MESSAGE BOX ===== */
QMessageBox {
    background-color: #FFFFFF;
}

QMessageBox QLabel {
    color: #2D3436;
}

/* ===== TOOL TIPS ===== */
QToolTip {
    background-color: #2D3436;
    color: #FFFFFF;
    border: none;
    border-radius: 4px;
    padding: 4px 8px;
}

/* ===== SPLASH SCREEN ===== */
QSplashScreen {
    background-color: #6C63FF;
    color: #FFFFFF;
}

/* ===== DROP ZONE ===== */
DropZoneWidget {
    background-color: #FFFFFF;
    border: 2px dashed #6C63FF;
    border-radius: 12px;
}

DropZoneWidget:hover {
    background-color: #F5F6FA;
    border-color: #5A52D5;
}